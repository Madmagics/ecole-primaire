[node name="List" type="VBoxContainer" parent="Panel/Margin/Content/Tabs/ContenuJeu/Scroll/ScrollMargin" unique_id=1617898916]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="ClassesTitle" type="Label" parent="Panel/Margin/Content/Tabs/ContenuJeu/Scroll/ScrollMargin/List" unique_id=1993054813]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Les classes et les matières"
autowrap_mode = 2

[node name="ClassesBody" type="Label" parent="Panel/Margin/Content/Tabs/ContenuJeu/Scroll/ScrollMargin/List" unique_id=78848358]
layout_mode = 2
text = "Une seule salle de classe accueille cinq professeurs, un par niveau du CP au CM2. Sept matières sont proposées au total : Mathématiques, Grammaire, Conjugaison, Orthographe, Anglais, Compréhension de texte et Logique."
autowrap_mode = 2

[node name="QuestionsTitle" type="Label" parent="Panel/Margin/Content/Tabs/ContenuJeu/Scroll/ScrollMargin/List" unique_id=159161777]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Les questions"
autowrap_mode = 2

[node name="QuestionsBody" type="Label" parent="Panel/Margin/Content/Tabs/ContenuJeu/Scroll/ScrollMargin/List" unique_id=434909886]
layout_mode = 2
text = "En cliquant sur un professeur, l'enfant reçoit un petit paquet de questions dans sa matière. Un résultat supérieur à la moitié des questions rapporte des pièces à la couleur de la matière, et un sans-faute (100 %) fait gagner un point de succès pour le défi de la classe et de la matière."
autowrap_mode = 2

[node name="RecompensesTitle" type="Label" parent="Panel/Margin/Content/Tabs/ContenuJeu/Scroll/ScrollMargin/List" unique_id=2009965787]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "La boutique et les récompenses"
autowrap_mode = 2

[node name="RecompensesBody" type="Label" parent="Panel/Margin/Content/Tabs/ContenuJeu/Scroll/ScrollMargin/List" unique_id=778981043]
layout_mode = 2
text = "L'icône « Récompenses » ouvre la boutique : les pièces permettent d'ouvrir des coffres pour obtenir de nouvelles cartes, ou d'acheter des tenues de professeur pour personnaliser chaque classe."
autowrap_mode = 2

[node name="DefisTitle" type="Label" parent="Panel/Margin/Content/Tabs/ContenuJeu/Scroll/ScrollMargin/List" unique_id=2111874738]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Les défis"
autowrap_mode = 2

[node name="DefisBody" type="Label" parent="Panel/Margin/Content/Tabs/ContenuJeu/Scroll/ScrollMargin/List" unique_id=1490052085]
layout_mode = 2
text = "L'icône « Succès » suit un défi par classe et par matière : plus on enchaîne les paquets sans erreur, plus la barre progresse, du bronze à l'argent puis à l'or. L'argent débloque une nouvelle musique de classe, l'or débloque un nouveau décor de classe."
autowrap_mode = 2

[node name="CartesTitle" type="Label" parent="Panel/Margin/Content/Tabs/ContenuJeu/Scroll/ScrollMargin/List" unique_id=900935007]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Les cartes"
autowrap_mode = 2

[node name="CartesBody" type="Label" parent="Panel/Margin/Content/Tabs/ContenuJeu/Scroll/ScrollMargin/List" unique_id=907628933]
layout_mode = 2
text = "Chaque coffre ouvert offre une carte à collectionner, qui rejoint aussitôt le « Livre » : l'album personnel où toutes les cartes obtenues restent consultables à tout moment."
autowrap_mode = 2

