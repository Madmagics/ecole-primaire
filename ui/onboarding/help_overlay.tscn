[node name="Intro" type="Label" parent="Panel/Margin/Content/Tabs/MisesAJour/Scroll/ScrollMargin/List" unique_id=483433055]
layout_mode = 2
text = "Voici ce qui arrive bientôt dans le jeu :"
autowrap_mode = 2

[node name="Liste" type="Label" parent="Panel/Margin/Content/Tabs/MisesAJour/Scroll/ScrollMargin/List" unique_id=1844344695]
layout_mode = 2
text = "- De nouvelles musiques de classe
- Un son amélioré dans tout le jeu
- Des corrections dans les questions
- Un ajustement de la difficulté"
autowrap_mode = 2

