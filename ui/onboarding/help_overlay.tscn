[node name="Title" type="Label" parent="Panel/Margin/Content/Tabs/Intro/Scroll/ScrollMargin/List" unique_id=1465213423]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Le but du jeu"
autowrap_mode = 2

[node name="Para1" type="Label" parent="Panel/Margin/Content/Tabs/Intro/Scroll/ScrollMargin/List" unique_id=1731051863]
layout_mode = 2
text = "Ce jeu transforme les révisions scolaires en aventure : chaque enfant explore une salle de classe virtuelle et progresse à son rythme, du CP jusqu'au CM2."
autowrap_mode = 2

[node name="Para2" type="Label" parent="Panel/Margin/Content/Tabs/Intro/Scroll/ScrollMargin/List" unique_id=102116207]
layout_mode = 2
text = "Dans cette salle, cinq professeurs proposent chacun de petites séries de questions, un par niveau du CP au CM2. Un résultat supérieur à la moitié rapporte des pièces, et un sans-faute fait avancer les défis de la classe."
autowrap_mode = 2

[node name="Para3" type="Label" parent="Panel/Margin/Content/Tabs/Intro/Scroll/ScrollMargin/List" unique_id=838784631]
layout_mode = 2
text = "Les pièces gagnées s'échangent ensuite à la boutique contre des cartes à collectionner, rangées dans un album personnel, ou contre de nouvelles tenues et décors pour la classe."
autowrap_mode = 2

[node name="Para4" type="Label" parent="Panel/Margin/Content/Tabs/Intro/Scroll/ScrollMargin/List" unique_id=1687447657]
layout_mode = 2
text = "Le tout se joue à la souris ou au doigt, sans texte compliqué ni raccourci clavier, pour rester accessible aux plus jeunes."
autowrap_mode = 2

[node name="Para5" type="Label" parent="Panel/Margin/Content/Tabs/Intro/Scroll/ScrollMargin/List" unique_id=172899045]
layout_mode = 2
text = "Un espace contrôle parental, réservé aux parents, permet de régler tranquillement le temps de jeu quotidien de chaque compte."
autowrap_mode = 2

[node name="ContenuJeu" type="MarginContainer" parent="Panel/Margin/Content/Tabs" unique_id=1430786389]
visible = false
