; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="L'école primaire"
config/description="S'amuser en révisant du CP au CM2"
config/version="1.01"
run/main_scene="res://levels/school/school.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/classe2.0/intro/chargement.png"
config/icon="uid://baywsvxfycwox"

[autoload]

EventBus="*res://autoload/event_bus.gd"
Economy="*res://autoload/economy.gd"
CardCollection="*res://autoload/card_collection.gd"
PlayerInputLock="*res://autoload/player_input_lock.gd"
ChallengeTracker="*res://autoload/challenge_tracker.gd"
ProfSkins="*res://autoload/prof_skins.gd"
ClassroomDecor="*res://autoload/classroom_decor.gd"
ClassroomMusic="*res://autoload/classroom_music.gd"
SaveManager="*res://autoload/save_manager.gd"
PseudoCache="*res://autoload/pseudo_cache.gd"
SoundManager="*res://autoload/sound_manager.gd"
NpcBubbleScheduler="*res://autoload/npc_bubble_scheduler.gd"
ServerApi="*res://autoload/server_api.gd"
ContentLibrary="*res://autoload/content_library.gd"
GameKeyboard="*res://ui/common/game_keyboard.gd"

[display]

window/stretch/mode="canvas_items"
window/handheld/orientation="landscape"

[gui]

theme/custom="res://ui/theme/game_theme.tres"

[importer_defaults]

texture={
"compress/channel_pack": 0,
"compress/hdr_compression": 1,
"compress/high_quality": false,
"compress/lossy_quality": 0.8,
"compress/mode": 1,
"compress/normal_map": 0,
"compress/rdo_quality_loss": 0.0,
"compress/uastc_level": 0,
"detect_3d/compress_to": 1,
"mipmaps/generate": false,
"mipmaps/limit": -1,
"process/channel_remap/alpha": 3,
"process/channel_remap/blue": 2,
"process/channel_remap/green": 1,
"process/channel_remap/red": 0,
"process/fix_alpha_border": true,
"process/hdr_as_srgb": false,
"process/hdr_clamp_exposure": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"process/size_limit": 0,
"roughness/mode": 0,
"roughness/src_normal": ""
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
