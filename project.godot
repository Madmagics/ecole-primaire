[application]

config/name="Projet petshop"
run/main_scene="res://levels/park_2d/park_2d.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/event_bus.gd"
Economy="*res://autoload/economy.gd"
CardCollection="*res://autoload/card_collection.gd"
PlayerInputLock="*res://autoload/player_input_lock.gd"
StatsTracker="*res://autoload/stats_tracker.gd"
GradeUnlock="*res://autoload/grade_unlock.gd"
SaveManager="*res://autoload/save_manager.gd"
SimpleGrass="*uid://bfq0snth8sj3h"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/simplegrasstextured/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[gui]

theme/custom="res://ui/theme/game_theme.tres"

