[sub_resource type="Resource" id="Resource_p0e02"]
script = ExtResource("2_d04sq")
grade = 1
text = "Milo est un chat noir et blanc qui habite avec Emma. Un matin, la porte du jardin reste ouverte. Milo sort tout doucement dans l'herbe mouillée. Il aperçoit un papillon jaune qui vole près des fleurs. Milo court après le papillon pendant longtemps. Quand il s'arrête, il ne reconnaît plus le chemin de la maison. Milo a très peur et se cache sous un buisson. Il miaule de plus en plus fort. Emma cherche son chat dans tout le jardin. Elle entend enfin les miaulements près du grand arbre. Emma prend Milo dans ses bras et le rassure doucement. Milo ronronne de bonheur. Ensemble, ils rentrent à la maison pour goûter."

