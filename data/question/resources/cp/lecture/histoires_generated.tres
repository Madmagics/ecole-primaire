[sub_resource type="Resource" id="Resource_e02mq"]
script = ExtResource("2_lihs0")
text = "Léa est à la plage. Elle est avec son papa. Elle prend un seau bleu. Elle prend une pelle rouge. Elle creuse le sable. Elle fait un château.

Le château à quatre tours. Elle met un drapeau jaune. Papa donne des coquillages. Elle orne le château. La mer vient tout près. Elle rit très fort. Elle rit un peu."

