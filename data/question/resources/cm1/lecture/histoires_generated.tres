[sub_resource type="Resource" id="Resource_ryavw"]
script = ExtResource("1_8da8x")
subject = 6
grade = 3
text = "Que veut dire \"abrite\" à propos du jardin accueillant les nombreuses espèces de papillons ?"
correct_answer = "protège et héberge en son sein"
choices = Array[String](["chasse et fait fuir activement", "vend au plus offrant", "détruit systématiquement"])
passage = SubResource("Resource_rqy2i")

[sub_resource type="Resource" id="Resource_yf1c1"]
script = ExtResource("1_8da8x")
subject = 6
grade = 3
text = "Pourquoi Selma reste-t-elle parfaitement immobile lorsque le papillon orange se pose sur son épaule ?"
correct_answer = "elle ne souhaite surtout pas effrayer ce fragile visiteur ailé"
choices = Array[String](["elle est en réalité totalement paralysée par une peur intense", "le guide le lui ordonne fermement à cet instant précis", "elle ne remarque tout simplement pas la présence du papillon"])
passage = SubResource("Resource_rqy2i")

[sub_resource type="Resource" id="Resource_20o72"]
script = ExtResource("1_8da8x")
subject = 6
grade = 3
text = "Pourquoi le guide insiste-t-il particulièrement sur le processus de métamorphose de la chenille ?"
correct_answer = "il souhaite transmettre aux élèves un phénomène naturel fascinant et instructif"
choices = Array[String](["ce sujet ne présente en réalité aucun intérêt pédagogique particulier", "les élèves l'interrogent insistamment sur ce point précis", "c'est le seul sujet que le guide maîtrise véritablement"])
passage = SubResource("Resource_rqy2i")

[sub_resource type="Resource" id="Resource_0i3yh"]
script = ExtResource("1_8da8x")
subject = 6
grade = 3
text = "Qu'est-ce qui montre que Selma a été profondément marquée par cette expérience au jardin des papillons ?"
correct_answer = "elle achète un souvenir spécifique pour conserver durablement ce moment vécu"
choices = Array[String](["elle oublie totalement cette sortie dès le lendemain", "elle se plaint d'un profond ennui pendant toute la visite", "elle refuse catégoriquement d'en reparler par la suite"])
passage = SubResource("Resource_rqy2i")

[sub_resource type="Resource" id="Resource_e15ad"]
script = ExtResource("1_8da8x")
subject = 6
grade = 3
text = "Pourquoi Selma choisit-elle d'acheter une simple carte postale plutôt qu'un véritable papillon en souvenir ?"
correct_answer = "elle respecte la fragilité et la liberté nécessaires à ces animaux délicats"
choices = Array[String](["elle n'a simplement pas assez d'argent disponible pour autre chose", "la vente de papillons vivants est totalement impossible dans ce jardin", "elle préfère nettement les cartes postales aux animaux vivants en général"])
passage = SubResource("Resource_rqy2i")

[sub_resource type="Resource" id="Resource_gvu7s"]
script = ExtResource("1_8da8x")
subject = 6
grade = 3
text = "Que peut-on déduire de l'attitude générale de Selma et de ses camarades tout au long de cette visite ?"
correct_answer = "ils font preuve d'une curiosité sincère et d'un grand respect envers la nature observée"
choices = Array[String](["ils se montrent globalement indifférents au spectacle qui leur est proposé", "ils cherchent principalement à s'amuser sans réel intérêt éducatif", "ils manifestent une peur constante face aux nombreux papillons présents"])
passage = SubResource("Resource_rqy2i")

[sub_resource type="Resource" id="Resource_tshlk"]
script = ExtResource("1_8da8x")
subject = 6
grade = 3
text = "Que peut-on déduire de l'objectif pédagogique poursuivi par cette sortie scolaire de fin d'année ?"
correct_answer = "elle vise à sensibiliser les élèves à la biodiversité et à la fragilité du monde naturel"
choices = Array[String](["elle sert uniquement à occuper agréablement une dernière journée de classe", "elle n'entretient aucun lien réel avec les apprentissages scolaires habituels", "elle est organisée uniquement pour récompenser les meilleurs élèves de l'année"])
passage = SubResource("Resource_rqy2i")

